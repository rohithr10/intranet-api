# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Browser origins allowed to call this API with cookies, comma-separated and
# with no trailing slash. This is an allow-list: "*" is not valid alongside
# credentials, so every frontend deployment must be named here.
#   local dev:  http://127.0.0.1:5173,http://localhost:5173
#   production: https://your-app.vercel.app
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/intranet
# Used only by `npm test`, which DROPS these collections. Never point it at a
# database you care about.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/intranet_test

# ─── Authentication ────────────────────────────────────────────────────────────
# Generate each one separately with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cookie behaviour. COOKIE_SECURE must be true behind HTTPS.
#
# COOKIE_SAMESITE:
#   lax  — frontend and API share a domain (app.example.com + api.example.com),
#          or the frontend proxies /api through to this service. Preferred.
#   none — frontend and API are on different sites (a *.vercel.app page calling
#          an *.onrender.com API). Requires COOKIE_SECURE=true, and browsers are
#          progressively restricting these as third-party cookies.
#
# COOKIE_DOMAIN: leave empty for a host-only cookie. Set it to ".example.com"
# to share the session between a frontend and an API on sibling subdomains.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# ─── Initial Super Admin (read only by the seed script) ───────────────────────
# Remove these from the environment once the first administrator exists. The
# seed never resets an existing account's password.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!

# ─── Media storage ─────────────────────────────────────────────────────────────
# local = files on disk under STORAGE_LOCAL_DIR, served from PUBLIC_BASE_URL/uploads.
# On a platform with an ephemeral filesystem this MUST point at a mounted
# volume, or every upload is lost on the next deploy.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
MAX_UPLOAD_SIZE_MB=8

# This API's own public origin. It is baked into every media record's URL, so
# set it correctly before uploading anything.
PUBLIC_BASE_URL=http://127.0.0.1:4000

# ─── Seeding ───────────────────────────────────────────────────────────────────
# Where `npm run seed:demo` reads its demo artwork from. Defaults to
# ./seed-assets, which ships with this repository.
# SEED_ASSETS_DIR=
